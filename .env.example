# --- Clockify ---
# API key pessoal (Clockify > Profile Settings > API). Nunca versionar.
CLOCKIFY_API_KEY=
# ID do workspace de onde as horas serão lidas.
CLOCKIFY_WORKSPACE_ID=

# --- Mês de faturamento ---
# Dia em que cada período começa (1 a 28). O período termina no dia anterior do mês seguinte.
# Ex.: 26 => de 26/09 a 25/10, chamado "Outubro".
FATURAMENTO_DIA_INICIAL=26

# --- Horas ---
# Teto de horas do período de faturamento.
HORAS_MAX_MES=168
# Meta de horas por dia útil. Aceita decimal com ponto (7.5 = 7h30).
HORAS_META_DIA=7
